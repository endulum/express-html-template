generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id         Int     @id @default(autoincrement())
  username   String  @unique @db.VarChar(32)
  role       Role    @default(BASIC)
  password   String? @db.VarChar(255)
  githubUser String?
  githubId   Int?
}

enum Role {
  BASIC
  ADMIN
}
